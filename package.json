{
  "name": "pay-mate",
  "productName": "PayMate",
  "version": "0.1.2",
  "private": true,
  "description": "PayMate - card spending insights",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.electron.json && node scripts/copy-assets.cjs && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always",
    "build:web": "tsc --noEmit && vite build --mode web",
    "preview:web": "vite preview --mode web --outDir dist-web --port 4173",
    "dev:web": "vite --port 5173"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "israeli-bank-scrapers": "6.12.2",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.2"
  },
  "author": "tal-az",
  "build": {
    "appId": "com.paymate.app",
    "productName": "PayMate",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tal-az",
        "repo": "pay-mate",
        "releaseType": "release"
      }
    ]
  }
}
